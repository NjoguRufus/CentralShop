# Offline Login Credentials
# These credentials are used for emergency offline login when Firebase Auth is unavailable
# IMPORTANT: Change these values in your .env file for security
# In production, consider using hashed passwords

# Offline login email
VITE_OFFLINE_LOGIN_EMAIL=admin@centralshop.com

# Offline login password (plain text - change this!)
VITE_OFFLINE_LOGIN_PASSWORD=admin123

# Offline user role (one of: astraronix, mainAdmin, Admin, Cashier, Stock Manager)
VITE_OFFLINE_USER_ROLE=mainAdmin

# Offline user name (display name)
VITE_OFFLINE_USER_NAME=Offline Admin

# Offline shop name (e.g., CentralShop, KamweneShop)
VITE_OFFLINE_SHOP_NAME=CentralShop

# ============================
# OFFLINE LOGIN (ACTIVE USER)
# ============================
# This is the user the app will use for emergency offline login.
# It must match a real Firebase Auth user (email + password).

