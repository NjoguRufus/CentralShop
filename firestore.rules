rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Assumes users/{uid} contains { shopId: string, role: string }
    function getUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userDocExists() {
      return isSignedIn() && getUser(request.auth.uid).exists();
    }

    // Prefer custom claims when present; fallback to users/{uid}
    function userShopId() {
      return isSignedIn() && request.auth.token.shopId != null
        ? request.auth.token.shopId
        : (userDocExists() ? getUser(request.auth.uid).data.shopId : null);
    }

    function userRole() {
      return isSignedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : (userDocExists() ? getUser(request.auth.uid).data.role : null);
    }

    function isAstraronix() {
      return userRole() == 'astraronix';
    }

    function isShopMember(shopId) {
      return isSignedIn() && userShopId() == shopId;
    }

    function hasRole(requiredRole) {
      return isSignedIn() && userRole() == requiredRole;
    }

    function hasAnyRole(roles) {
      return isSignedIn() && userRole() in roles;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection (testing): allow reads for any signed-in user to unblock Employees page
    match /users/{userId} {
      allow read: if isSignedIn();
      // Keep writes open during testing; tighten later to Admin-only
      allow create, update, delete: if isSignedIn();
    }

    // Shop root doc (metadata) - write restricted
    match /shops/{shopId} {
      allow read: if isShopMember(shopId) || isAstraronix();
      allow write: if isAstraronix();
    }

    // Shop Prefixed Collections (Dynamic - works for any shop prefix)
    // Pattern: {ShopName}Settings/{docId}, {ShopName}Products/{productId}, etc.
    // Examples: CentralShopSettings, AnotherShopSettings, MyShopSettings
    
    // Settings: {ShopName}Settings/{docId}
    match /{shopSettings}/{docId} {
      allow read: if isSignedIn() && shopSettings.matches('.*Settings$');
      allow write: if isSignedIn() && shopSettings.matches('.*Settings$');
      allow update: if isSignedIn() 
        && shopSettings.matches('.*Settings$')
        && request.resource.data.keys().hasOnly(['businessInfo', 'themeSettings', 'paymentSettings', 'adminPassword', 'adminPasswordHint', 'aiAssistant'])
        && (!('themeSettings' in request.resource.data) || (
          request.resource.data.themeSettings.mode in ['light', 'dark']
          && request.resource.data.themeSettings.primaryColor is string
        ));
    }

    // Products: {ShopName}Products/{productId}
    match /{shopProducts}/{productId} {
      allow read: if isSignedIn() && shopProducts.matches('.*Products$');
      allow create, update: if isSignedIn() 
        && shopProducts.matches('.*Products$')
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.stock is number && request.resource.data.stock >= 0;
      allow delete: if isSignedIn() && shopProducts.matches('.*Products$');
    }

    // Customers: {ShopName}Customers/{customerId}
    match /{shopCustomers}/{customerId} {
      allow read: if true && shopCustomers.matches('.*Customers$'); // Public read for invoice view
      allow create, update, delete: if isSignedIn() && shopCustomers.matches('.*Customers$');
    }

    // Employees: {ShopName}Employees/{employeeId}
    match /{shopEmployees}/{employeeId} {
      allow read: if isSignedIn() && shopEmployees.matches('.*Employees$');
      allow create, update, delete: if isSignedIn() && shopEmployees.matches('.*Employees$');
    }

    // Product Categories: {ShopName}ProductCategories/{categoryId}
    match /{shopProductCategories}/{categoryId} {
      allow read: if isSignedIn() && shopProductCategories.matches('.*ProductCategories$');
      allow create, update, delete: if isSignedIn() && shopProductCategories.matches('.*ProductCategories$');
    }

    // Legacy nested collections (for backward compatibility)
    // Settings: shops/{shopId}/settings/{docId}
    match /shops/{shopId}/settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['businessInfo', 'themeSettings', 'paymentSettings', 'adminPassword', 'adminPasswordHint', 'aiAssistant'])
        && (!('themeSettings' in request.resource.data) || (
          request.resource.data.themeSettings.mode in ['light', 'dark']
          && request.resource.data.themeSettings.primaryColor is string
        ));
    }

    // Products: shops/{shopId}/products/{productId} (legacy)
    match /shops/{shopId}/products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.stock is number && request.resource.data.stock >= 0;
      allow delete: if isSignedIn();
    }

    // Orders: shops/{shopId}/orders/{orderId} (legacy - kept for backward compatibility)
    match /shops/{shopId}/orders/{orderId} {
      allow read: if isSignedIn();

      // Relaxed for testing: allow signed-in create with core validation
        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['items', 'subtotal', 'tax', 'total', 'status', 'paymentMethod', 'createdAt', 'employeeId'])
          && request.resource.data.total == request.resource.data.subtotal + request.resource.data.tax
          && request.resource.data.subtotal >= 0
          && request.resource.data.tax >= 0
          && request.resource.data.total >= 0
          && request.resource.data.status in ['completed', 'pending', 'cancelled', 'partial']
          && request.resource.data.items.size() > 0;

      // Allow only status changes client-side
      allow update: if isSignedIn()
        && resource.data.diff(request.resource.data).changedKeys().hasOnly(['status'])
        && request.resource.data.status in ['completed','pending','cancelled','partial'];

      allow delete: if isSignedIn();
    }

    // Shop-specific Orders Collections: {ShopName}Orders/{orderId}
    // Matches collections like "CentralShopOrders", "AnotherShopOrders", etc.
    match /{shopOrdersCollection=**}/orders/{orderId} {
      // Only match collections ending with "Orders"
      allow read, write: if isSignedIn() 
        && shopOrdersCollection.matches('.*Orders$');
    }
    
    // Orders: {ShopName}Orders/{orderId}
    match /{shopOrders}/{orderId} {
      allow read: if isSignedIn() && shopOrders.matches('.*Orders$');
      allow create: if isSignedIn() 
        && shopOrders.matches('.*Orders$')
        && request.resource.data.keys().hasAll(['items', 'subtotal', 'tax', 'total', 'status', 'paymentMethod', 'createdAt', 'employeeId'])
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.tax
        && request.resource.data.subtotal >= 0
        && request.resource.data.tax >= 0
        && request.resource.data.total >= 0
        && request.resource.data.status in ['completed', 'pending', 'cancelled', 'partial']
        && request.resource.data.items.size() > 0;
      allow update: if isSignedIn() 
        && shopOrders.matches('.*Orders$')
        && resource.data.diff(request.resource.data).changedKeys().hasOnly(['status', 'category'])
        && request.resource.data.status in ['completed','pending','cancelled','partial'];
      allow delete: if isSignedIn() && shopOrders.matches('.*Orders$');
    }

    // Invoices: {ShopName}Invoices/{invoiceId}
    match /{shopInvoices}/{invoiceId} {
      allow read: if true && shopInvoices.matches('.*Invoices$'); // Public read for shareable invoice links
      allow create, update, delete: if isSignedIn() && shopInvoices.matches('.*Invoices$');
    }

    // Legacy nested collections (for backward compatibility)
    // Customers: shops/{shopId}/customers/{customerId}
    match /shops/{shopId}/customers/{customerId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Employees: shops/{shopId}/employees/{employeeId} (legacy)
    match /shops/{shopId}/employees/{employeeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Invoices: shops/{shopId}/invoices/{invoiceId} (legacy)
    match /shops/{shopId}/invoices/{invoiceId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Suppliers: {ShopName}Suppliers/{supplierId}
    match /{shopSuppliers}/{supplierId} {
      allow read: if isSignedIn() && shopSuppliers.matches('.*Suppliers$');
      allow create, update, delete: if isSignedIn() && shopSuppliers.matches('.*Suppliers$');
    }

    // Supplier supplies: {ShopName}Suppliers/{supplierId}/supplies/{supplyId}
    match /{shopSuppliers}/{supplierId}/supplies/{supplyId} {
      allow read: if isSignedIn() && shopSuppliers.matches('.*Suppliers$');
      allow create, update, delete: if isSignedIn() && shopSuppliers.matches('.*Suppliers$');
    }

    // Legacy Suppliers (for backward compatibility)
    match /shops/{shopId}/suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Legacy Supplier supplies (for backward compatibility)
    match /shops/{shopId}/suppliers/{supplierId}/supplies/{supplyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Expenses
    match /shops/{shopId}/expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.amount is number && request.resource.data.amount >= 0;
      // For delete, request.resource is null, so validate using existing resource
      allow delete: if isSignedIn();
    }

    // Expense categories
    match /shops/{shopId}/expenseCategories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Order categories
    match /shops/{shopId}/orderCategories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Product categories: productCategories/{categoryId}
    match /productCategories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Legacy: Product categories: shops/{shopId}/productCategories/{categoryId}
    match /shops/{shopId}/productCategories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Services and bookings
    match /shops/{shopId}/services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    match /shops/{shopId}/serviceBookings/{bookingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Stock reports
    match /shops/{shopId}/stockReports/{reportId} {
      allow read: if isSignedIn();
      allow create, update, delete: if (isShopMember(shopId) && hasAnyRole(['Admin'])) || isAstraronix();
    }

    // AI Chat History: shops/{shopId}/ai_chats/{chatId}
    match /shops/{shopId}/ai_chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['title', 'topic', 'category', 'createdAt', 'updatedAt', 'messageCount', 'messages'])
        && request.resource.data.title is string
        && request.resource.data.topic is string
        && request.resource.data.category is string
        && request.resource.data.messageCount is number
        && request.resource.data.messageCount >= 0
        && request.resource.data.messages is list;
      
      allow update: if isSignedIn()
        && request.resource.data.keys().hasAll(['title', 'topic', 'category', 'createdAt', 'updatedAt', 'messageCount', 'messages'])
        && request.resource.data.title is string
        && request.resource.data.topic is string
        && request.resource.data.category is string
        && request.resource.data.messageCount is number
        && request.resource.data.messageCount >= 0
        && request.resource.data.messages is list;
      
      allow delete: if isSignedIn();
    }

    // Employee Activity: shops/{shopId}/employee_activities/{activityId}
    match /shops/{shopId}/employee_activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['employeeId', 'employeeName', 'action', 'timestamp'])
        && request.resource.data.employeeId is string
        && request.resource.data.employeeName is string
        && request.resource.data.action in ['login', 'logout']
        && request.resource.data.timestamp is timestamp;
      
      allow update, delete: if isSignedIn();
    }
  }
}



